{
  "expo": {
    "name": "Field App",
    "slug": "field-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "fieldapp",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0F7B3E",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.officeops.fieldapp",
      "permissions": [
        "CAMERA",
        "ACCESS_NETWORK_STATE",
        "INTERNET",
        "VIBRATE",
        "android.permission.CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#0F7B3E"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.officeops.fieldapp",
      "infoPlist": {
        "NSCameraUsageDescription": "Field App uses the camera to scan barcodes and for face check-in at the gate.",
        "NSLocationWhenInUseUsageDescription": "Field App records your location at check-in to confirm you are on site."
      }
    },
    "plugins": [
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Field App uses the camera to scan barcodes and for face check-in at the gate.",
          "enableCodeScanner": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Field App records your location at check-in to confirm you are on site."
        }
      ],
      "onnxruntime-react-native"
    ],
    "extra": {
      "eas": {
        "projectId": "5428db61-c637-4123-8b90-65c1bd684799"
      }
    }
  }
}
